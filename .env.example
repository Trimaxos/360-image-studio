# Cloud AI (fal.ai)
FAL_AI_KEY=your_fal_ai_key_here
AI_MODEL=fal-ai/flux-2/klein/9b/edit

# Local AI (FLUX.1-Fill-dev GGUF Q4_K_M, ~8GB VRAM)
LOCAL_AI_ENABLED=true
LOCAL_AI_AUTO_START=false
LOCAL_AI_GGUF_PATH=./models/flux1-fill-dev-Q4_K_M.gguf
LOCAL_AI_PYTHON=python3
LOCAL_AI_PORT=8765
LOCAL_AI_BASE_URL=http://127.0.0.1:8765

# Translate
DEEPSEEK_API_KEY=your_deepseek_api_key_here
PORT=3001

# Simple login (change these values before sharing the app)
AUTH_USERNAME=admin
# Format: scrypt$salt$hash. Generate a new salted hash before deployment.
AUTH_PASSWORD_HASH='scrypt$3ed216f2c20a4a460216a7b4d26c72e8$fb37179cb06c35b9e09158132d1d78b0cdedb629c359ab6e18ff072477b4d98e5b3ee3887e557d202aeeba38d13506cd5385507844fa4b03312ecd44a04a9a06'
