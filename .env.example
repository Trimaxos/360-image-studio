# Cloud AI (fal.ai)
FAL_AI_KEY=your_fal_ai_key_here
AI_MODEL=fal-ai/flux-2/klein/9b/edit

# Local AI (FLUX.1-Fill-dev GGUF Q4_K_M, ~8GB VRAM)
LOCAL_AI_ENABLED=true
LOCAL_AI_AUTO_START=false
LOCAL_AI_GGUF_PATH=./models/flux1-fill-dev-Q4_K_M.gguf
LOCAL_AI_PYTHON=python3
LOCAL_AI_PORT=8765
LOCAL_AI_BASE_URL=http://127.0.0.1:8765

# Translate
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Backup translation provider via opencode-go (Zen) — used when the DeepSeek key is missing or fails
OPENCODE_API_KEY=your_opencode_go_api_key_here
PORT=3001

# 9router (local OpenAI-compatible gateway) - Codex image edit via a ChatGPT account
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=your_9router_api_key_here
