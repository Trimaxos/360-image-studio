FROM docker.io/pytorch/pytorch:2.9.1-cuda12.8-cudnn9-runtime

ARG APP_UID=10001
ARG APP_GID=10001

LABEL io.360-image-studio.flux-fill-assets="false"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/cache/huggingface \
    MODEL_PATH=/models/flux1-fill-dev-Q4_K_M.gguf \
    BASE_MODEL_PATH=/opt/models/flux-fill-base \
    LOCAL_AI_HOST=0.0.0.0 \
    LOCAL_AI_PORT=8765 \
    LOCAL_AI_OFFLINE=true \
    PRELOAD_MODEL=true

RUN groupadd --gid "${APP_GID}" localai \
    && useradd --uid "${APP_UID}" --gid "${APP_GID}" --create-home localai \
    && mkdir -p /app /cache/huggingface /models /opt/models/flux-fill-base \
    && chown -R localai:localai /app /cache /models /opt/models

COPY containers/local-ai/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir --requirement /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY --chown=localai:localai server/services/local_ai_server.py /app/local_ai_server.py
COPY --chown=localai:localai server/services/prepare_local_ai_assets.py /app/prepare_local_ai_assets.py

USER localai
WORKDIR /app
EXPOSE 8765

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=8 \
  CMD python -c "import json,urllib.request; d=json.load(urllib.request.urlopen('http://127.0.0.1:8765/health', timeout=3)); raise SystemExit(0 if d.get('status') in ('loading','ready') else 1)"

CMD ["gunicorn", "--bind", "0.0.0.0:8765", "--workers", "1", "--threads", "4", "--timeout", "900", "--graceful-timeout", "30", "local_ai_server:app"]
