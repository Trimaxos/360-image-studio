# Cloud AI (fal.ai)
FAL_AI_KEY=your_fal_ai_key_here

# Translate
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Backup translation provider via opencode-go (Zen) — used when the DeepSeek key is missing or fails
OPENCODE_API_KEY=your_opencode_go_api_key_here
PORT=3001

# 9router (local OpenAI-compatible gateway on this computer) - Codex image edit via a ChatGPT account
NINEROUTER_API_KEY=your_9router_api_key_here
