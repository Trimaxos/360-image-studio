# Cloud AI (fal.ai)
FAL_AI_KEY=your_fal_ai_key_here

# Translate
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Backup translation provider via opencode-go (Zen) — used when the DeepSeek key is missing or fails
OPENCODE_API_KEY=your_opencode_go_api_key_here
PORT=3001

# Simple login (change these values before sharing the app)
AUTH_USERNAME=admin
# Format: scrypt$salt$hash. Generate a new salted hash before deployment.
AUTH_PASSWORD_HASH='scrypt$3ed216f2c20a4a460216a7b4d26c72e8$fb37179cb06c35b9e09158132d1d78b0cdedb629c359ab6e18ff072477b4d98e5b3ee3887e557d202aeeba38d13506cd5385507844fa4b03312ecd44a04a9a06'
